#!/usr/bin/env bash
# rmx — git worktrees / jj workspaces + agent, rex multiplexer edition.
#
# Port of wmx with no tmux or workmux dependency: same gum UI, same
# worktree layout (<repo>__worktrees/<branch>), and the devenv binding
# from the main checkout is copied into the new worktree when one
# exists. Windows and sessions live in rex.
#
# Usage:
#   rmx [prompt…]     pick a project, describe a task, launch a worktree
#                     with an agent working on it. With a prompt argument,
#                     skips the pickers and uses the current repo.
#
# Internal subcommands (spawned detached):
#   rmx __create <path> <session> <prompt_file> [title]

set -euo pipefail

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  cat <<'EOF'
Usage: rmx [prompt…]

Pick a project, describe a task, and launch a worktree with an agent
working on it in a rex window. With a prompt argument, skips the
pickers and uses the current repo.
EOF
  exit 0
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/rmx"
mkdir -p "$state_dir"
log="$state_dir/last-create.log"

notify() {
  # No rex equivalent of tmux display-message; use a macOS notification
  # so background progress still reaches the user, and always log.
  echo "rmx: $1" >>"$log"
  if command -v osascript >/dev/null 2>&1; then
    osascript - "$1" <<'OSA' >/dev/null 2>&1 || true
on run argv
  display notification (item 1 of argv) with title "rmx"
end run
OSA
  fi
}

fail() {
  detail=$(tail -1 "$log" 2>/dev/null || true)
  notify "failed: $1 ${detail:+— $detail}"
  exit 1
}

# Copy the main checkout's devenv binding (plain auto-activation trust
# or an out-of-tree --from binding) into the worktree. Bindings live in
# ~/.local/share/devenv/allowed keyed by absolute path, so a worktree
# (a different path) has no environment without this. No-op when the
# main checkout has no binding.
devenv_rebind() {
  local root=$1 wt=$2
  local allowed="${XDG_DATA_HOME:-$HOME/.local/share}/devenv/allowed"

  [ -f "$allowed" ] || return 0
  command -v devenv >/dev/null || return 0

  # Latest entry for the main checkout wins
  local entry from
  entry=$(jq -c --arg root "$root" 'select(.path == $root)' "$allowed" | tail -n1)
  [ -n "$entry" ] || return 0

  from=$(jq -r '.from // empty' <<<"$entry")
  if [ -z "$from" ]; then
    # In-tree devenv.nix is checked out in the worktree; just grant trust
    (cd "$wt" && devenv allow)
    return 0
  fi
  case "$from" in
    *:*) ;;                                        # flake ref or path:/abs
    /*)  from="path:$from" ;;                      # absolute path
    *)   from="path:$(cd "$root/$from" && pwd)" ;; # relative to main checkout
  esac

  local args=(--from "$from")
  local profile
  while IFS= read -r profile; do
    args+=(--profile "$profile")
  done < <(jq -r '.profiles[]? // empty' <<<"$entry")

  (cd "$wt" && devenv allow "${args[@]}")
}

# ---------------------------------------------------------------- create ---

create() {
  local path=$1 session=$2 prompt_file=$3 title=${4:-}

  trap 'rm -f "${prompt_file:-}"' EXIT
  : >"$log"

  cd "$path" || fail "cd $path"

  # jj workspaces when the repo is jj (the usual case), git worktrees
  # otherwise
  local vcs=git
  if jj root >/dev/null 2>&1; then vcs=jj; fi

  # Branch/workspace name, generated by pi from the prompt when there
  # is one.
  local branch
  if [ -s "$prompt_file" ]; then
    branch=$(pi -p "Generate a concise git branch name based on the task description.
Rules: 2-4 words, kebab-case, all lowercase, no prefix like feature/. Output ONLY the branch name.

$(cat "$prompt_file")" 2>>"$log" \
      | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g' | sed -E 's/^-+|-+$//g' \
      | awk -F- 'NF && NF <= 6' | head -1 | cut -c1-50 | sed -E 's/-+$//') || true
    [ -n "${branch:-}" ] || fail "auto-name branch"
  else
    branch=$title
  fi

  # Base: the repo's trunk when there is one (workmux's base_branch =
  # "auto" behaved this way), otherwise the current checkout.
  local base="" default
  if [ "$vcs" = jj ]; then
    if jj log --no-graph --limit 1 -r 'trunk()' -T 'commit_id' 2>/dev/null | grep -q .; then
      base='trunk()'
    fi
  else
    default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null \
      | sed 's|^origin/||') || true
    if [ -n "${default:-}" ] && git show-ref --verify --quiet "refs/heads/$default"; then
      base=$default
    fi
  fi

  # Worktree layout matches workmux: <repo>__worktrees/<branch>, next
  # to the main checkout. Name collisions retry with numeric suffixes
  # since there is no user to ask.
  local wt n ok=""
  provision() {
    # jj workspace add won't create intermediate directories (git does)
    mkdir -p "$(dirname "$2")"
    local args=()
    if [ "$vcs" = jj ]; then
      [ -n "$base" ] && args=(--revision "$base")
      jj workspace add "$2" --name "$1" "${args[@]}" >>"$log" 2>&1
    else
      [ -n "$base" ] && args=("$base")
      git worktree add -b "$1" "$2" "${args[@]}" >>"$log" 2>&1
    fi
  }
  wt="$(dirname "$path")/$(basename "$path")__worktrees/$branch"
  if provision "$branch" "$wt"; then
    ok=$branch
  else
    for n in 2 3 4 5; do
      grep -qi 'already exists' "$log" || break
      : >"$log"
      wt="$(dirname "$path")/$(basename "$path")__worktrees/$branch-$n"
      if provision "$branch-$n" "$wt"; then
        ok="$branch-$n"
        break
      fi
    done
  fi
  [ -n "$ok" ] || fail "provision worktree"
  branch=$ok

  # The agent reads its task from the worktree at launch time.
  if [ -s "$prompt_file" ]; then
    mkdir -p "$wt/.rmx"
    cp "$prompt_file" "$wt/.rmx/PROMPT.md"
  fi

  # devenv copy-over: replicate the main checkout's binding if it exists
  devenv_rebind "$path" "$wt" >>"$log" 2>&1 || fail "devenv rebind"

  # Agent: project override via .workmux.yaml's agent key, else pi
  local agent=pi a
  if [ -f .workmux.yaml ]; then
    a=$(sed -n 's/^agent:[[:space:]]*//p' .workmux.yaml | head -1)
    [ -n "$a" ] && agent="$a"
  fi

  # Target rex session: the picked project's session (created if
  # missing), else the session rmx is running in, else one named after
  # the current project. Panes run fish explicitly: rex's default is
  # the macOS account shell (zsh), not the preferred shell.
  local target=""
  local shell_bin="${RMX_SHELL:-fish}"
  if [ -n "$session" ]; then
    target=$(rex ls --json | jq -r --arg s "$session" \
      '.sessions[] | select(.label == $s) | .session_id' | head -1)
    if [ -z "$target" ]; then
      target=$(rex new "$session" -c "$path" --window Terminal --json -- "$shell_bin" | jq -r '.session_id') \
        || fail "rex new $session"
    fi
  elif [ -n "${REX_SESSION:-}" ]; then
    target=$REX_SESSION
  else
    target=$(rex ls --json | jq -r --arg s "$(basename "$path")" \
      '.sessions[] | select(.label == $s) | .session_id' | head -1)
    if [ -z "$target" ]; then
      target=$(rex new "$(basename "$path")" -c "$path" --window Terminal --json -- "$shell_bin" | jq -r '.session_id') \
        || fail "rex new"
    fi
  fi

  # The agent window: a plain shell in the worktree, in the background.
  # The agent command is delivered once the shell is ready (fish init +
  # devenv hook can take 10s+), same as wmx-launch.
  local created block window_id
  created=$(rex window new -s "$target" "$branch" -c "$wt" --focus=false --json -- "$shell_bin") \
    || fail "rex window new"
  block=$(printf '%s' "$created" | jq -r '.block_ids[0]')
  window_id=$(printf '%s' "$created" | jq -r '.window_id')

  # Wait for the first prompt (starship ❯). On timeout, send anyway:
  # a late command is better than none.
  for _ in $(seq 1 90); do
    rex capture -s "$target" -b "$block" --trim 2>/dev/null | grep -q '❯' && break
    sleep 2
  done

  local launch main_q
  printf -v main_q '%q' "$path"
  if [ -s "$prompt_file" ]; then
    case "$agent" in
      # Match the per-agent prompt-passing conventions
      claude) launch="RMX_MAIN=$main_q rmx-agent claude -- \"\$(cat .rmx/PROMPT.md)\"" ;;
      *)      launch="RMX_MAIN=$main_q rmx-agent $agent \"\$(cat .rmx/PROMPT.md)\"" ;;
    esac
  else
    launch="RMX_MAIN=$main_q rmx-agent $agent"
  fi
  if ! { rex send -s "$target" -b "$block" "$launch" &&
    rex send-key -s "$target" -b "$block" enter; }; then
    fail "send agent command"
  fi

  # Show the new window in a connected app, if there is one.
  local client
  client=$(rex client ls --json 2>/dev/null \
    | jq -r '[.clients[] | select(.info.kind == "app")] | .[0].client_id // empty')
  if [ -n "$client" ]; then
    rex -C "$client" "do" session.select "session_id=$target" "window_id=$window_id" >/dev/null 2>&1 || true
  fi

  notify "created '$branch' — agent starting"
}

# Internal entry point: rmx __create <path> <session> <prompt_file> [title]
if [ "${1:-}" = "__create" ]; then
  shift
  create "$@"
  exit
fi

# ------------------------------------------------------------------- UI ---

# Non-interactive: `rmx "fix the flaky test"` uses the current repo
prompt="${*:-}"

current_root=$(jj root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null || pwd)
current_name=$(basename "$current_root")

path="$current_root"
session=""

# User aborts (Esc/ctrl-c in gum) are not errors: exit 0 quietly.
if [ -z "$prompt" ]; then
  choice=$(gum choose --header "Where should the agent work?" \
    "Current project: $current_name" \
    "Pick another project…") || exit 0
  if [ "$choice" = "Pick another project…" ]; then
    # Session name: authoritative for existing/configured sessions,
    # directory basename otherwise (matches how sesh names new ones)
    selection=$(sesh list --json -dH \
      | jq -r '.[] | (if .Src == "tmux" or .Src == "config" then .Name else (.Path | sub("/$";"") | split("/") | last) end) as $s | "\($s)\t\(.Path)\t\(.Icon // "")"' \
      | gum filter --placeholder "Pick a project…") || exit 0
    session=$(printf '%s' "$selection" | cut -f1)
    path=$(printf '%s' "$selection" | cut -f2)
  fi

  prompt=$(gum write --header "Task for the agent" \
    --placeholder "Describe the task… (ctrl-d when done)" \
    --char-limit 0 --height 8) || exit 0
fi

# Prompt-less launch: fall back to a hand-typed worktree title
title=""
if [ -z "$prompt" ]; then
  title=$(gum input --placeholder "Worktree title (empty to abort)") || exit 0
  [ -n "$title" ] || exit 0
fi

# Everything after this point — branch naming, provisioning, devenv,
# agent launch — happens in the background. The user only hears back
# via a notification: an issue, or "created".
prompt_file=$(mktemp)
printf '%s' "$prompt" >"$prompt_file"

if [ -n "${REX_SESSION:-}${TMUX:-}" ]; then
  nohup "$0" __create "$path" "$session" "$prompt_file" "$title" \
    </dev/null >/dev/null 2>&1 &
  notify "creating worktree in the background…"
else
  create "$path" "$session" "$prompt_file" "$title"
fi

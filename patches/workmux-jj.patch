+/// Metadata key recording the branch name workmux assigned to a jj workspace.
+/// jj keeps HEAD detached in its workspaces, so this stands in for the branch.
+pub const JJ_BRANCH_META_KEY: &str = "jj-branch";
+
+/// Whether a worktree handle was created by workmux as a jj workspace.
+pub fn is_jj_workspace(handle: &str) -> bool {
+    get_worktree_meta(handle, JJ_BRANCH_META_KEY).is_some()
+}
+
+/// Whether the repository is a colocated jj repo (has `.jj` next to `.git`).
+pub fn is_jj_repo(main_worktree_root: &Path) -> bool {
+    main_worktree_root.join(".jj").is_dir()
+}
+
+/// Create a jj workspace (which jj also registers as a git worktree).
+/// No bookmark is created; the workspace is identified by its name.
+pub fn create_jj_workspace_in(
+    worktree_path: &Path,
+    name: &str,
+    revision: &str,
+    workdir: &Path,
+) -> Result<()> {
+    let path_str = worktree_path
+        .to_str()
+        .ok_or_else(|| anyhow!("Invalid worktree path"))?;
+
+    // Unlike `git worktree add`, jj does not create missing parent directories.
+    if let Some(parent) = worktree_path.parent() {
+        std::fs::create_dir_all(parent)
+            .with_context(|| format!("Failed to create directory '{}'", parent.display()))?;
+    }
+
+    Cmd::new("jj")
+        .workdir(workdir)
+        .args(&["workspace", "add", "--name", name, "-r", revision, path_str])
+        .run()
+        .context("Failed to create jj workspace")?;
+    Ok(())
+}
+
+/// Forget a jj workspace. Its commits stay visible in the repo.
+pub fn forget_jj_workspace_in(name: &str, repo_root: &Path) -> Result<()> {
+    Cmd::new("jj")
+        .workdir(repo_root)
+        .args(&["workspace", "forget", name])
+        .run()
+        .context("Failed to forget jj workspace")?;
+    Ok(())
+}
+
 /// Move a registered worktree to a new path using `git worktree move`.
 ///
 /// Git updates the worktree admin dir's `gitdir` file and the worktree's
@@ -340,7 +390,23 @@ pub fn list_worktrees_with_main_in(workdir: Option<&Path>) -> Result<WorktreeLis
     let list = cmd
         .run_and_capture_stdout()
         .context("Failed to list worktrees")?;
-    parse_worktree_listing(&list)
+    let mut listing = parse_worktree_listing(&list)?;
+
+    // jj workspaces always show as detached; map them back to the branch
+    // name workmux recorded for them, keyed by handle (directory name).
+    if listing.worktrees.iter().any(|(_, b)| b == "(detached)") {
+        let jj_branches = get_all_worktree_meta_key_in(workdir, JJ_BRANCH_META_KEY);
+        for (path, branch) in &mut listing.worktrees {
+            if branch == "(detached)"
+                && let Some(handle) = path.file_name().and_then(|n| n.to_str())
+                && let Some(jj_branch) = jj_branches.get(handle)
+            {
+                *branch = jj_branch.clone();
+            }
+        }
+    }
+
+    Ok(listing)
 }
 
